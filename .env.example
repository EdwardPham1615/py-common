# pycommon configuration reference
#
# Copy this into a service that consumes pycommon and edit what you need:
#
#     cp .env.example .env
#
# Every key is live and set to the value pycommon already uses, so a fresh copy
# changes nothing -- it starts the service exactly as an empty .env would, and
# there is a test that keeps that true. What it buys you is a written list of
# what exists, with the default in front of you when you decide to change it.
#
# Eight keys are left commented out instead. Those are the settings whose
# default is "off", and no value can say that: an empty number fails to parse
# outright, and an empty string is a different thing from unset. Each shows an
# example of the shape it wants, so uncommenting one is a decision rather than a
# guess.
#
# ---------------------------------------------------------------------------
# Three things that are not obvious
# ---------------------------------------------------------------------------
#
# 1. Nested keys follow the FIELD NAME your service declares, not the class.
#    The `POSTGRES__` prefix below exists because the convention is to call the
#    field `postgres`:
#
#        class Settings(BaseAppSettings):
#            app_name: str = "my-service"
#            postgres: DatabaseSettings = DatabaseSettings()
#            redis: RedisSettings = RedisSettings()
#
#    Name the field `db` instead and the keys become `DB__HOST`. Only `http`,
#    `server` and `cors` are on BaseAppSettings already; every other group is
#    yours to declare, and its keys do nothing until you do.
#
#    The keys with no prefix at all -- ENVIRONMENT, APP_NAME, APP_VERSION,
#    DEBUG, LOG_LEVEL -- are plain fields on BaseAppSettings rather than a
#    group, so there is no `__` to write. Everything configuring the HTTP
#    surface is under HTTP__ or CORS__, with no exceptions.
#
#    Check spelling against this file rather than guessing: `extra="ignore"`
#    means a misspelled key is dropped without a word, and the setting silently
#    keeps its default.
#
# 2. Lists must be JSON, not comma-separated. `CORS__ORIGINS=a,b` raises
#    SettingsError at start-up; `CORS__ORIGINS=["a","b"]` is the form.
#
# 3. Env files load as `.env` first, then `.env.{ENVIRONMENT}` on top -- but
#    ENVIRONMENT itself is only read from the process environment or from
#    `.env`, in that order. Putting it in `.env.production` alone does nothing
#    at all: that file is only chosen once the environment is known, so it is
#    never even loaded, and the service comes up as dev with no error. Set
#    ENVIRONMENT where it will be read, and expect silence rather than a
#    complaint if you do not.
#
#    Start-up does reject one case: the env files resolving to one environment
#    while the loaded settings claim another.
#
# ---------------------------------------------------------------------------
# Before production
# ---------------------------------------------------------------------------
#
# These defaults are built for a laptop and are wrong anywhere else:
#
#   ENVIRONMENT                   still says dev
#   POSTGRES__PASSWORD            "postgres"
#   KEYCLOAK__CLIENT_SECRET       empty -- and belongs in a secret store, not here
#   S3__ACCESS_KEY / SECRET_KEY   "any"
#   CORS__ORIGINS                 a Vite dev server
#   SERVER__FORWARDED_ALLOW_IPS   unset, so behind an ingress every anonymous
#                                 caller shares one rate-limit bucket and HSTS
#                                 is never emitted
#   SERVER__DRAIN_DELAY_SECONDS   0, so a rolling deploy drops in-flight requests


# ===========================================================================
# Core
# ===========================================================================

# dev | staging | production. An unknown value raises and names where it came
# from rather than quietly falling back to dev.
ENVIRONMENT=dev

APP_NAME=app
APP_VERSION=0.1.0
DEBUG=false

# DEBUG | INFO | WARNING | ERROR | CRITICAL. A typo falls back to INFO rather
# than silencing the service.
LOG_LEVEL=INFO


# ===========================================================================
# CORS -- browser policy (on BaseAppSettings already)
# ===========================================================================

# JSON arrays, not CSV. A Vite dev server by default, which is what makes it
# wrong everywhere else. "*" with credentials enabled is rejected by browsers.
CORS__ORIGINS=["http://localhost:5173"]
CORS__ALLOW_CREDENTIALS=true
CORS__ALLOW_METHODS=["*"]
CORS__ALLOW_HEADERS=["*"]


# ===========================================================================
# SERVER -- uvicorn and process lifecycle (on BaseAppSettings already)
# ===========================================================================

SERVER__HOST=0.0.0.0
SERVER__PORT=8000

# Peers whose X-Forwarded-* headers uvicorn should trust. Its default,
# 127.0.0.1, never matches a Kubernetes ingress pod, so until this is set the
# client address is the ingress: HSTS is never emitted and every anonymous
# caller shares one rate-limit bucket.
#SERVER__FORWARDED_ALLOW_IPS=10.0.0.0/8

# Keep serving this long after SIGTERM with readiness failing, so load
# balancers can take the instance out before it stops listening. Must stay
# below terminationGracePeriodSeconds. 0 disables draining.
SERVER__DRAIN_DELAY_SECONDS=0


# ===========================================================================
# HTTP -- middleware knobs (on BaseAppSettings already)
# ===========================================================================

# Per-request ceiling. Unset installs no timeout. Set it *below* the ingress
# timeout, so the deadline that fires is the one that can explain itself.
#HTTP__TIMEOUT_SECONDS=30

# No default on purpose: the tight policy an API wants blanks out Swagger UI
# and ReDoc, and one loose enough for them protects nothing.
#HTTP__CONTENT_SECURITY_POLICY=default-src 'none'; frame-ancestors 'none'

HTTP__HSTS=true
HTTP__HSTS_MAX_AGE=31536000

# Reject request bodies larger than this. Unset accepts any size; 1 MiB
# (1048576) suits a JSON API.
#HTTP__MAX_BODY_BYTES=1048576

# Gzip responses at least this many bytes. Unset installs no compression.
# 500-1000 suits a JSON API; below roughly a packet the header costs more than
# it saves. Check whether your ingress already compresses before enabling.
#HTTP__GZIP_MIN_SIZE=500

# How long a replayable Idempotency-Key response is kept.
HTTP__IDEMPOTENCY_TTL_SECONDS=86400

# Prefix for RFC 9457 problem `type` URIs. Unset emits path-absolute types like
# /problems/input, which are valid but resolve to nothing; set it to serve them
# as documentation a caller can actually open.
#HTTP__PROBLEM_TYPE_BASE_URL=https://docs.example.com/problems


# ===========================================================================
# POSTGRES -- requires `postgres: DatabaseSettings` on your Settings
# ===========================================================================

POSTGRES__HOST=localhost
POSTGRES__PORT=5432
POSTGRES__USER=postgres
POSTGRES__PASSWORD=postgres
POSTGRES__DB=app

POSTGRES__POOL_SIZE=5
POSTGRES__MAX_OVERFLOW=10
POSTGRES__POOL_PRE_PING=true

# Drop and reopen a pooled connection at this age. pgbouncer, cloud load
# balancers and NAT gateways all close idle connections on their own schedule
# without telling the pool, and the next checkout then fails with "server
# closed the connection unexpectedly". Keep this below the shortest such
# timeout in front of the database. -1 disables recycling.
POSTGRES__POOL_RECYCLE_SECONDS=1800

# Wait this long for a free connection before raising, rather than blocking a
# request forever behind an exhausted pool.
POSTGRES__POOL_TIMEOUT_SECONDS=30

POSTGRES__ECHO=false
POSTGRES__ECHO_POOL=false

# Structured query logging through structlog.
POSTGRES__LOG_QUERIES=false
# 0 logs every query at debug; above 0 warns only when a query is slower.
POSTGRES__SLOW_QUERY_THRESHOLD_MS=0
# Off by default: bind parameters are where the PII and the secrets are.
POSTGRES__LOG_QUERY_PARAMS=false

# Run `alembic upgrade head` on startup. Keep false in production and migrate
# from a deploy job -- several instances starting at once will race.
POSTGRES__AUTO_MIGRATE=false
POSTGRES__MIGRATIONS_SCRIPT_LOCATION=alembic


# ===========================================================================
# REDIS -- requires `redis: RedisSettings` on your Settings
# ===========================================================================

# The database number in the URL is part of the config: two services sharing
# one Redis on db 0 share a keyspace.
REDIS__URL=redis://localhost:6379/0

REDIS__MAX_CONNECTIONS=10
REDIS__LOCK_TIMEOUT_SECONDS=30

# redis-py blocks forever without these, so a hung connection pins an
# event-loop task instead of failing fast.
REDIS__SOCKET_TIMEOUT_SECONDS=5
REDIS__SOCKET_CONNECT_TIMEOUT_SECONDS=5

# Ping idle connections before reuse -- a load balancer may have dropped them.
REDIS__HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS__RETRY_ON_TIMEOUT=true


# ===========================================================================
# KEYCLOAK -- requires `keycloak: KeycloakSettings` on your Settings
# ===========================================================================

KEYCLOAK__SERVER_URL=http://localhost:8080
KEYCLOAK__REALM=app
KEYCLOAK__CLIENT_ID=app-api

# A secret. Inject it from the platform's secret store; do not commit it.
KEYCLOAK__CLIENT_SECRET=

# Defaults to CLIENT_ID when unset.
#KEYCLOAK__AUDIENCE=app-api

KEYCLOAK__ALGORITHMS=["RS256"]
KEYCLOAK__JWKS_CACHE_TTL_SECONDS=3600

# Turning this off accepts tokens minted for another client in the same realm.
KEYCLOAK__VERIFY_AUD=true


# ===========================================================================
# OTEL -- requires `otel: OtelSettings` on your Settings
# ===========================================================================

OTEL__ENABLED=true
OTEL__SERVICE_NAME=app
OTEL__EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# false requires TLS to the collector.
OTEL__EXPORTER_OTLP_INSECURE=true

# Fraction of traces sampled. 1.0 keeps everything, which is fine until it is
# not; 0.05 is a common production figure.
OTEL__TRACES_SAMPLER_ARG=1.0

# Switchable apart from traces on purpose: sampling traces down is normal,
# while metrics must stay complete for a rate or error ratio to mean anything.
OTEL__METRICS_ENABLED=true
OTEL__METRICS_EXPORT_INTERVAL_MS=60000

# Serve a scrape endpoint as well as pushing OTLP. Mount build_metrics_router()
# for the path to exist.
OTEL__PROMETHEUS_ENABLED=false
OTEL__PROMETHEUS_PATH=/metrics


# ===========================================================================
# S3 -- requires `s3: StorageSettings` on your Settings
# ===========================================================================

S3__ENDPOINT_URL=http://localhost:8333
S3__ACCESS_KEY=any
S3__SECRET_KEY=any
S3__REGION=us-east-1
S3__BUCKET=app

# MinIO and SeaweedFS need path style; AWS S3 does not.
S3__USE_PATH_STYLE=true

# Base URL for objects served publicly, when that differs from the endpoint
# (a CDN in front of the bucket).
#S3__PUBLIC_BASE_URL=https://cdn.example.com


# ===========================================================================
# PROFILER -- requires `profiler: ProfilerSettings` and the `profiling` extra
# ===========================================================================

PROFILER__ENABLED=false
PROFILER__SAMPLE_RATE=0.1
PROFILER__SLOW_REQUEST_THRESHOLD_MS=200
PROFILER__ALWAYS_PROFILE_ERRORS=true

# The dashboard exposes internals; it stays off in production unless the flag
# below is also set, which you should not set.
PROFILER__ENABLE_DASHBOARD=false
PROFILER__DASHBOARD_PATH=/__profiler__
PROFILER__ALLOW_DASHBOARD_IN_PRODUCTION=false

# Paths never profiled -- probes would dominate the sample.
PROFILER__FILTER_PATHS=["/health","/health/live","/health/ready"]
